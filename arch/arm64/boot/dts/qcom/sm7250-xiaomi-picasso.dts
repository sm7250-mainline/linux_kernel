				interrupts = <0x00 0x259 0x04>;
				dmas = <0x2e 0x00 0x00 0x01 0x2e 0x01 0x00 0x01>;
				dma-names = "tx", "rx";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
