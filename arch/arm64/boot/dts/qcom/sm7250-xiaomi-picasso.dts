	aliases {
		serial0 = "/soc@0/geniqup@8c0000/serial@888000";
		serial1 = "/soc@0/geniqup@8c0000/serial@894000";
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			label = "Volume Up";
			gpios = <0x3e 0x05 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,sm7250-pmic-glink", "qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x60>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x47>;
					};
				};
			};
		};
	};
};
