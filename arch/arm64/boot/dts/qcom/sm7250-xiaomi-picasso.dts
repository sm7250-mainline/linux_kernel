/*
 * picasso 主线 bring-up 权威设备树（迭代 24 起为唯一源）。
 * 来源：scripts/runtime-dtb-picasso.dts 全量覆盖（迭代 0-23 全部实机验证
 * 状态的最终形态，含显式 phandle 编号——dtc 原样保留，确定性构建）。
 * 原 dtsi 组织结构备份于 sm7250-xiaomi-picasso.dts.dtsi-based.bak；
 * scripts/runtime-dtb-picasso.dts 保留作为出问题时的对照参考，不再参与构建。
 */

/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Xiaomi Redmi K30 5G (Picasso)";
	compatible = "xiaomi,picasso", "qcom,sm7250", "qcom,lito-mtp", "qcom,lito", "qcom,mtp";
	qcom,msm-id = <0x190 0x10000>;
	qcom,board-id = <0x24 0x00>;
	chassis-type = "handset";

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		stdout-path = "serial0:115200n8";
		framebuffer@a0000000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xa0000000 0x00 0x9e3400>;
			width = <0x438>;
			height = <0x960>;
			stride = <0x10e0>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x249f000>;
			clock-output-names = "xo_board";
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			clock-output-names = "sleep_clk";
			phandle = <0x29>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0xa6>;
			next-level-cache = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x17>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x02>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x06>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0xa6>;
			next-level-cache = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x18>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x07>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0xa6>;
			next-level-cache = <0x09>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x19>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x09>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0xa6>;
			next-level-cache = <0x0b>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0b>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0xa6>;
			next-level-cache = <0x0d>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0d>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0xa6>;
			next-level-cache = <0x0f>;
			power-domains = <0x10>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0f>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x189>;
			next-level-cache = <0x11>;
			power-domains = <0x12>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x11>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0x00 0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x1ac>;
			next-level-cache = <0x14>;
			power-domains = <0x15>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x02>;
			#cooling-cells = <0x02>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x14>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x17>;
				};

				core1 {
					cpu = <0x18>;
				};

				core2 {
					cpu = <0x19>;
				};

				core3 {
					cpu = <0x1a>;
				};

				core4 {
					cpu = <0x1b>;
				};

				core5 {
					cpu = <0x1c>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x1d>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x1e>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "little-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x2be>;
				exit-latency-us = <0x393>;
				min-residency-us = <0xfa1>;
				local-timer-stop;
				phandle = <0x20>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "big-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x20e>;
				exit-latency-us = <0x73e>;
				min-residency-us = <0x15b3>;
				local-timer-stop;
				phandle = <0x21>;
			};

			cluster-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "cluster-power-collapse";
				arm,psci-suspend-param = <0x4100c244>;
				entry-latency-us = <0xcbf>;
				exit-latency-us = <0x19a2>;
				min-residency-us = <0x2662>;
				local-timer-stop;
				phandle = <0x22>;
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x3cc00000>,
		      <0x00 0xc0000000 0x00 0x40000000>,
		      <0x01 0x00000000 0x01 0x00000000>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x20>;
			phandle = <0x03>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x20>;
			phandle = <0x08>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x20>;
			phandle = <0x0a>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x20>;
			phandle = <0x0c>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x20>;
			phandle = <0x0e>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x20>;
			phandle = <0x10>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x21>;
			phandle = <0x12>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1f>;
			domain-idle-states = <0x21>;
			phandle = <0x15>;
		};

		power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x22>;
			phandle = <0x1f>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@80000000 {
			reg = <0x00 0x80000000 0x00 0x600000>;
			no-map;
		};

		xbl_aop_mem: memory@80600000 {
			/* live dts: xbl_aop_region 实为 0x80600000+0x260000，此前少保留 0x80600000-0x80700000 */
			reg = <0x00 0x80600000 0x00 0x260000>;
			no-map;
		};

		memory@80860000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x80860000 0x00 0x20000>;
			no-map;
		};

		xbl_uefi_log_mem: memory@80880000 {
			/* live dts: res_xbl_uefi_log_region */
			reg = <0x00 0x80880000 0x00 0x14000>;
			no-map;
		};

		memory@80900000 {
			reg = <0x00 0x80900000 0x00 0x200000>;
			no-map;
			phandle = <0x23>;
		};

		memory@80b00000 {
			reg = <0x00 0x80b00000 0x00 0x1300000>;
			no-map;
		};
		sec_apps_mem: memory@808ff000 {
			reg = <0x00 0x808ff000 0x00 0x1000>;
			no-map;
		};
		qtee_apps_mem: memory@81e00000 {
			reg = <0x00 0x81e00000 0x00 0x4200000>;
			no-map;
		};
		pil_camera_mem: memory@86000000 {
			reg = <0x00 0x86000000 0x00 0x500000>;
			no-map;
		};
		pil_npu_mem: memory@86500000 {
			reg = <0x00 0x86500000 0x00 0x500000>;
			no-map;
		};
		pil_video_mem: memory@86a00000 {
			reg = <0x00 0x86a00000 0x00 0x500000>;
			no-map;
		};
		pil_cdsp_mem: memory@87400000 {
			reg = <0x00 0x87400000 0x00 0x1e00000>;
			no-map;
		};
		pil_wlan_mem: memory@8ba00000 {
			reg = <0x00 0x8ba00000 0x00 0x200000>;
			no-map;
		};
		pil_ipa_fw_mem: memory@8bc00000 {
			reg = <0x00 0x8bc00000 0x00 0x10000>;
			no-map;
		};
		pil_ipa_gsi_mem: memory@8bc10000 {
			reg = <0x00 0x8bc10000 0x00 0x5400>;
			no-map;
		};
		dfps_mem: memory@a2300000 {
			reg = <0x00 0xa2300000 0x00 0x100000>;
			no-map;
		};

		memory@89200000 {
			reg = <0x00 0x89200000 0x00 0x2800000>;
			no-map;
		};

		memory@8c000000 {
			reg = <0x00 0x8c000000 0x00 0xf800000>;
			no-map;
		};

		memory@9f400000 {
			reg = <0x00 0x9f400000 0x00 0xc00000>;
			no-map;
		};

		memory@a0000000 {
			reg = <0x00 0xa0000000 0x00 0x2300000>;
			no-map;
		};

		pil-gpu-mem@8bc15400 {
			reg = <0x00 0x8bc15400 0x00 0x2000>;
			no-map;
			phandle = <0x4f>;
		};

		reserved_pil_mem: memory@8bc17400 {
			/* live dts: reserved_pil_mem_region，补齐 0x8bc17400-0x8c000000 空洞 */
			reg = <0x00 0x8bc17400 0x00 0x3e8c00>;
			no-map;
		};
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <0x23>;
		hwlocks = <0x24 0x03>;
	};

	opp-table-qup {
		compatible = "operating-points-v2";

		opp-50000000 {
			opp-hz = <0x00 0x2faf080>;
			required-opps = <0x25>;
		};

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x26>;
		};

		opp-120000000 {
			opp-hz = <0x00 0x7270e00>;
			required-opps = <0x27>;
		};
	};

	soc@0 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		dma-ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		compatible = "simple-bus";

		interrupt-controller@17a00000 {
			compatible = "arm,gic-v3";
			reg = <0x00 0x17a00000 0x00 0x10000 0x00 0x17a60000 0x00 0x100000>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			interrupts = <0x01 0x08 0x04>;
			phandle = <0x01>;
		};

		timer@17c20000 {
			compatible = "arm,armv7-timer-mem";
			reg = <0x00 0x17c20000 0x00 0x1000>;
			clock-frequency = <0x124f800>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x00 0x20000000>;

			frame@17c21000 {
				frame-number = <0x00>;
				interrupts = <0x00 0x08 0x04 0x00 0x06 0x04>;
				reg = <0x17c21000 0x1000 0x17c22000 0x1000>;
			};

			frame@17c23000 {
				frame-number = <0x01>;
				interrupts = <0x00 0x09 0x04>;
				reg = <0x17c23000 0x1000>;
				status = "disabled";
			};

			frame@17c25000 {
				frame-number = <0x02>;
				interrupts = <0x00 0x0a 0x04>;
				reg = <0x17c25000 0x1000>;
				status = "disabled";
			};

			frame@17c27000 {
				frame-number = <0x03>;
				interrupts = <0x00 0x0b 0x04>;
				reg = <0x17c27000 0x1000>;
				status = "disabled";
			};

			frame@17c29000 {
				frame-number = <0x04>;
				interrupts = <0x00 0x0c 0x04>;
				reg = <0x17c29000 0x1000>;
				status = "disabled";
			};

			frame@17c2b000 {
				frame-number = <0x05>;
				interrupts = <0x00 0x0d 0x04>;
				reg = <0x17c2b000 0x1000>;
				status = "disabled";
			};

			frame@17c2d000 {
				frame-number = <0x06>;
				interrupts = <0x00 0x0e 0x04>;
				reg = <0x17c2d000 0x1000>;
				status = "disabled";
			};
		};

		interrupt-controller@b220000 {
			compatible = "qcom,sm7250-pdc", "qcom,pdc";
			reg = <0x00 0xb220000 0x00 0x30000 0x00 0x17c000f0 0x00 0x60>;
			qcom,pdc-ranges = <0x00 0x1e0 0x2a 0x2a 0x264 0x1c 0x46 0x3f 0x01 0x47 0x280 0x0f 0x56 0x20a 0x34>;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupt-controller;
			phandle = <0x3a>;
		};

		clock-controller@100000 {
			compatible = "qcom,gcc-sm7250";
			reg = <0x00 0x100000 0x00 0x1f0000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			clock-names = "bi_tcxo", "bi_tcxo_ao", "sleep_clk";
			clocks = <0x28 0x00 0x28 0x01 0x29>;
			phandle = <0x2a>;
		};

		mailbox@408000 {
			compatible = "qcom,sm7250-ipcc", "qcom,ipcc";
			reg = <0x00 0x408000 0x00 0x1000>;
			interrupts = <0x00 0xe5 0x04>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			#mbox-cells = <0x02>;
			phandle = <0x46>;
		};

		efuse@780000 {
			compatible = "qcom,sm7250-qfprom", "qcom,qfprom";
			reg = <0x00 0x780000 0x00 0x7000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			gpu-speed-bin@1ea {
				/* live 实测：reg 长度必须 2 字节（bits<5,8> 跨字节；
				   原写 0x01 被 nvmem core 判 "invalid bits" →
				   qfprom probe -22 → gpu 的 fw_devlink supplier 失败 */
				reg = <0x1ea 0x02>;
				bits = <0x05 0x08>;
				phandle = <0x4e>;
			};
		};

		rng@793000 {
			compatible = "qcom,prng-ee";
			reg = <0x00 0x793000 0x00 0x1000>;
			clocks = <0x2a 0x82>;
			clock-names = "core";
		};

		hwlock@1f40000 {
			compatible = "qcom,tcsr-mutex";
			syscon = <0x2b 0x00 0x1000>;
			#hwlock-cells = <0x01>;
			phandle = <0x24>;
		};

		syscon@1f40000 {
			compatible = "syscon";
			reg = <0x00 0x1f40000 0x00 0x20000>;
			phandle = <0x2b>;
		};

		watchdog@17c10000 {
			compatible = "qcom,apss-wdt-sm7250", "qcom,kpss-wdt";
			reg = <0x00 0x17c10000 0x00 0x1000>;
			interrupts = <0x00 0x00 0x01 0x00 0x01 0x01>;
			clocks = <0x29>;
		};

		restart@c264000 {
			compatible = "qcom,pshold";
			reg = <0x00 0xc264000 0x00 0x04 0x00 0x1fd3000 0x00 0x04>;
			reg-names = "pshold-base", "tcsr-boot-misc-detect";
		};

		dma-controller@800000 {
			compatible = "qcom,sm7250-gpi-dma", "qcom,sdm845-gpi-dma";
			reg = <0x00 0x800000 0x00 0x60000>;
			interrupts = <0x00 0xf4 0x04 0x00 0xf5 0x04 0x00 0xf6 0x04 0x00 0xf7 0x04 0x00 0xf8 0x04 0x00 0xf9 0x04 0x00 0xfa 0x04 0x00 0xfb 0x04 0x00 0xfc 0x04 0x00 0xfd 0x04>;
			dma-channels = <0x0a>;
			dma-channel-mask = <0x1f>;
			iommus = <0x2c 0x4f6 0x00>;
			#dma-cells = <0x03>;
			status = "disabled";
			phandle = <0x2e>;
		};

		dma-controller@900000 {
			compatible = "qcom,sm7250-gpi-dma", "qcom,sdm845-gpi-dma";
			reg = <0x00 0x900000 0x00 0x60000>;
			interrupts = <0x00 0x117 0x04 0x00 0x118 0x04 0x00 0x119 0x04 0x00 0x11a 0x04 0x00 0x11b 0x04 0x00 0x11c 0x04 0x00 0x125 0x04 0x00 0x126 0x04 0x00 0x127 0x04 0x00 0x128 0x04>;
			dma-channels = <0x0a>;
			dma-channel-mask = <0x3f>;
			iommus = <0x2c 0x36 0x00>;
			#dma-cells = <0x03>;
			status = "disabled";
			phandle = <0x34>;
		};

		geniqup@8c0000 {
			compatible = "qcom,geni-se-qup";
			reg = <0x00 0x8c0000 0x00 0x2000>;
			clock-names = "m-ahb", "s-ahb";
			clocks = <0x2a 0x28 0x2a 0x29>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			iommus = <0x2c 0x4e3 0x00>;
