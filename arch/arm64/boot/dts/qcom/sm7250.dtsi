			qcom,bcm-voters = <&apps_bcm_voter>;
			/* 迭代 30: qnoc 幽灵 BCM(SN11/12/14/15,SH8/10)已裁表, 启用 */
			status = "okay";
		};
		mmss_noc: interconnect@1740000 {
			compatible = "qcom,sm7250-mmss-noc";
			reg = <0 0x1740000 0 0x1c100>;
			#interconnect-cells = <2>;
			qcom,bcm-voters = <&apps_bcm_voter>;
			/* 迭代 30: qnoc 幽灵 BCM(SN11/12/14/15,SH8/10)已裁表, 启用 */
			status = "okay";
		};
		npu_noc: interconnect@9160000 {
			compatible = "qcom,sm7250-dc-noc";
			reg = <0 0x9160000 0 0x3200>;
			#interconnect-cells = <2>;
			qcom,bcm-voters = <&apps_bcm_voter>;
			/* 迭代 30: qnoc 幽灵 BCM(SN11/12/14/15,SH8/10)已裁表, 启用 */
			status = "okay";
		};
		gem_noc: interconnect@9680000 {
			compatible = "qcom,sm7250-gem-noc";
			reg = <0 0x9680000 0 0x3e200>;
			#interconnect-cells = <2>;
			qcom,bcm-voters = <&apps_bcm_voter>;
			/* 迭代 30: qnoc 幽灵 BCM(SN11/12/14/15,SH8/10)已裁表, 启用 */
			status = "okay";
		};
		mc_virt: interconnect-mc-virt {
			compatible = "qcom,sm7250-mc-virt";
			#interconnect-cells = <2>;
			qcom,bcm-voters = <&apps_bcm_voter>;
			/* 迭代 30: qnoc 幽灵 BCM(SN11/12/14/15,SH8/10)已裁表, 启用 */
			status = "okay";
		};
		spmi_bus: spmi@c440000 {
			compatible = "qcom,spmi-pmic-arb";
			reg =
				<0 0xc440000 0 0x1100 0 0xc600000 0 0x2000000 0 0xe600000 0 0x100000>,
				<0 0xe700000 0 0xa0000 0 0xc40a000 0 0x26000>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			interrupt-names = "periph_irq";
			interrupts-extended = <&pdc 1 4>;
			qcom,ee = <0>;
			qcom,channel = <0>;
			#address-cells = <2>;
			#size-cells = <0>;
			interrupt-controller;
			#interrupt-cells = <4>;
			pm8150l: pmic@4 {
				compatible = "qcom,pm8150l", "qcom,spmi-pmic";
				reg = <4 0>;
				#address-cells = <1>;
				#size-cells = <0>;
				pm8150l_gpios: gpio@c000 {
					compatible =
						"qcom,pm8150l-gpio",
						"qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					#gpio-cells = <2>;
					/* gpio-ranges 自引用已删除（同 tlmm，defer 死循环） */
					interrupt-controller;
					#interrupt-cells = <2>;
				};
			};
		};
		ufshc: ufshc@1d84000 {
			compatible = "qcom,sm7250-ufshc", "qcom,ufshc",
				     "jedec,ufs-2.0";
			reg = <0 0x1d84000 0 0x3000 0 0x1d90000 0 0x8000>;
			reg-names = "std", "ice";
			interrupts = <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&ufs_mem_phy>;
			phy-names = "ufsphy";
			lanes-per-direction = <2>;
			power-domains = <&gcc UFS_PHY_GDSC>;
			#reset-cells = <1>;
			resets = <&gcc GCC_UFS_PHY_BCR>;
			reset-names = "rst";
			clock-names =
				"core_clk",
				"bus_aggr_clk",
				"iface_clk",
				"core_clk_unipro",
				"core_clk_ice",
				"core_clk_ice_hw_ctl",
				"ref_clk",
				"tx_lane0_sync_clk",
				"rx_lane0_sync_clk",
				"rx_lane1_sync_clk";
			clocks =
				<&gcc GCC_UFS_PHY_AXI_CLK>,
				<&gcc GCC_AGGRE_UFS_PHY_AXI_CLK>,
				<&gcc GCC_UFS_PHY_AHB_CLK>,
				<&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
				<&gcc GCC_UFS_PHY_ICE_CORE_CLK>,
				<&gcc GCC_UFS_PHY_ICE_CORE_HW_CTL_CLK>,
				<&rpmhcc RPMH_CXO_CLK>,
				<&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
				<&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>,
				<&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK>;
/*
			 * The ICE core RCG must be able to scale between 75 and
			 * 300 MHz; the remaining entries are enable-only clocks.
			 */
			freq-table-hz =
				<0x2faf080 0xbebc200>,
				<0 0>,
				<0 0>,
				<0x23c3460 0x8f0d180>,
				<0x47868c0 0x11e1a300>,
				<0x47868c0 0x11e1a300>,
				<0 0>,
				<0 0>,
				<0 0>,
				<0 0>;
/*
			 * The controller does not route transfers through the apps
			 * SMMU: the downstream factory DT and the live DT both
			 * have no iommus here, and dma-direct addresses work.
			 */
			limit-hs-gear = <3>;
/*
			 * Bandwidth votes for the two paths used by the upstream
			 * SM8250 description.
			 */
			interconnects =
				<&aggre1_noc 6 0>,
				<&mc_virt 1 0>,
				<&gem_noc 0 0>,
				<&config_noc 45 0>;
			interconnect-names = "ufs-ddr", "cpu-ufs";
/*
			 * The 19.2 MHz reference clock value follows the
			 * downstream lito DT.  The device reset uses the
			 * dedicated UFS reset pinctrl group, not a GPIO.
			 */
			dev-ref-clk-freq = <0>;
			status = "disabled";
		};
		ufs_mem_phy: phy@1d87000 {
			compatible = "qcom,sm7250-qmp-ufs-phy";
			reg = <0 0x1d87000 0 0xe00>;
			#phy-cells = <0>;
/*
			 * The "qphy" input votes for the qphy.lvl RPMh resource
			 * while the PHY is powered.  It is an enable-only vote,
			 * not a rate.
			 */
			clock-names = "qphy", "ref", "ref_aux", "qref";
			clocks =
				<&rpmhcc RPMH_QLINK_CLK_A>,
				<&rpmhcc RPMH_CXO_CLK>,
				<&gcc GCC_UFS_PHY_PHY_AUX_CLK>,
				<&gcc GCC_UFS_1X_CLKREF_CLK>;
			resets = <&ufshc 0>;
			reset-names = "ufsphy";
/*
			 * Values and lito-specific TX/RX offsets come from the
			 * downstream v4-lito PHY driver.
			 */
			status = "disabled";
		};
		sdhc_1: mmc@7c4000 {
			compatible = "qcom,sm7250-sdhci", "qcom,sdhci-msm-v5";
			reg =
				<0 0x7c4000 0 0x1000 0 0x7c5000 0 0x1000 0 0x7c8000 0 0x8000>;
			reg-names = "hc", "cqhci", "ice";
			interrupts = <0 202 4 0 204 4>;
			interrupt-names = "hc_irq", "pwr_irq";
			bus-width = <8>;
			clocks =
				<&gcc GCC_SDCC1_AHB_CLK>,
				<&gcc GCC_SDCC1_APPS_CLK>,
				<&gcc GCC_SDCC1_ICE_CORE_CLK>;
			clock-names = "iface", "core", "ice_core";
			iommus = <&apps_smmu 192 0>;
			status = "disabled";
		};
		sdhc_2: mmc@8804000 {
			compatible = "qcom,sm7250-sdhci", "qcom,sdhci-msm-v5";
			reg = <0 0x8804000 0 0x1000>;
			interrupts = <0 207 4 0 223 4>;
			interrupt-names = "hc_irq", "pwr_irq";
			bus-width = <4>;
			clocks =
				<&gcc GCC_SDCC2_AHB_CLK>,
				<&gcc GCC_SDCC2_APPS_CLK>;
			clock-names = "iface", "core";
			iommus = <&apps_smmu 192 0>;
			status = "disabled";
		};
		llcc: cache-controller@9200000 {
			compatible = "qcom,sm7250-llcc";
			reg = <0 0x9200000 0 0xd0000 0 0x9600000 0 0x50000>;
			reg-names = "llcc_base", "llcc_broadcast_base";
		};
		llcc_dcvs: interconnect@18321000 {
			compatible = "qcom,sm7250-osm-l3", "qcom,osm-l3";
			reg = <0 0x18321000 0 0x1000>;
			clocks = <&rpmhcc RPMH_CXO_CLK &gcc GPLL0>;
			clock-names = "xo", "alternate";
			#interconnect-cells = <1>;
			/* bringup: 随 qnoc 一并禁用 */
			status = "disabled";
		};
		cpufreq_hw: cpufreq@18323000 {
			compatible =
				"qcom,sm7250-cpufreq-hw",
				"qcom,cpufreq-hw";
			reg =
				<0 0x18323000 0 0x1000 0 0x18325800 0 0x1000 0 0x18327800 0 0x1000>;
			reg-names =
				"freq-domain0",
				"freq-domain1",
				"freq-domain2";
			clocks = <&rpmhcc RPMH_CXO_CLK &gcc GPLL0>;
			clock-names = "xo", "alternate";
			#freq-domain-cells = <1>;
			#clock-cells = <1>;
		};
		apps_smmu: iommu@15000000 {
			compatible =
				"qcom,sm7250-smmu-500",
				"qcom,smmu-500",
				"arm,mmu-500";
			reg = <0 0x15000000 0 0x100000>;
			#iommu-cells = <2>;
			#global-interrupts = <1>;
			interrupts =
				<0 65 4 0 97 4 0 98 4 0 99 4 0 100 4 0 101 4 0 102 4 0 103 4 0>,
				<104 4 0 105 4 0 106 4 0 107 4 0 108 4 0 109 4 0 110 4 0 111 4>,
				<0 112 4 0 113 4 0 114 4 0 115 4 0 116 4 0 117 4 0 118 4 0 181>,
				<4 0 182 4 0 183 4 0 184 4 0 0x13b 4 0 0x13c 4 0 0x13d 4 0 0x13e>,
				<4 0 0x13f 4 0 0x140 4 0 0x141 4 0 0x142 4 0 0x143 4 0 0x144 4>,
				<0 0x145 4 0 0x146 4 0 0x147 4 0 0x148 4 0 0x149 4 0 0x14a 4 0>,
				<0x14b 4 0 0x14c 4 0 0x14d 4 0 0x14e 4 0 0x14f 4 0 0x150 4 0 0x151>,
				<4 0 0x152 4 0 0x153 4 0 0x154 4 0 0x155 4 0 0x156 4 0 0x157 4>,
				<0 0x158 4 0 0x159 4 0 0x18b 4 0 0x18c 4 0 0x18d 4 0 0x18e 4 0>,
				<0x18f 4 0 0x190 4 0 0x191 4 0 0x192 4 0 0x193 4 0 0x194 4 0 0x195>,
				<4 0 0x196 4 0 0x197 4 0 0x198 4 0 0x199 4>;
		};
		tsens0: thermal-sensor@c263000 {
			compatible = "qcom,sm7250-tsens", "qcom,tsens-v2";
			reg = <0 0xc263000 0 0x1ff 0 0xc222000 0 8>;
			#qcom,sensors = <17>;
			interrupts-extended = <&pdc 26 4 &pdc 28 4>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};
		tsens1: thermal-sensor@c265000 {
			compatible = "qcom,sm7250-tsens", "qcom,tsens-v2";
			reg = <0 0xc265000 0 0x1ff 0 0xc223000 0 8>;
			#qcom,sensors = <12>;
			interrupts-extended = <&pdc 27 4 &pdc 29 4>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};
		spm: power-management@c300000 {
			compatible = "qcom,sm7250-aoss-qmp", "qcom,aoss-qmp";
			reg = <0 0xc300000 0 0x400>;
			interrupts-extended = <&aoss_qmp 0 0 1>;
			mboxes = <&aoss_qmp 0 0>;
			#clock-cells = <0>;
		};
		refgen: regulator@ff1000 {
			/* live dts 实测：lito refgen 在 0xff1000（kona 同款 IP）；
					   88e7000 是 kona 地址，误用会访问 USB QMP 区域 */
			compatible = "qcom,sm8250-refgen-regulator";
			reg = <0 0xff1000 0 132>;
		};
		qusb_1_phy: phy@88e3000 {
			compatible =
				"qcom,sm7250-usb-hs-phy",
				"qcom,usb-snps-hs-7nm-phy";
			reg = <0 0x88e3000 0 0x400>;
			status = "disabled";
			#phy-cells = <0>;
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "ref";
			resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
		};
		usb_1_qmp_phy: phy@88e8000 {
			compatible = "qcom,sm8250-qmp-usb3-dp-phy";
			reg = <0 0x88e8000 0 0x3000>;
			status = "disabled";
			clocks =
				<&gcc GCC_USB3_PRIM_PHY_AUX_CLK>,
				<&rpmhcc RPMH_CXO_CLK>,
				<&gcc GCC_USB3_PRIM_PHY_COM_AUX_CLK>,
				<&gcc GCC_USB3_PRIM_PHY_PIPE_CLK>;
			clock-names = "aux", "ref", "com_aux", "usb3_pipe";
			resets =
				<&gcc GCC_USB3_DP_PHY_PRIM_BCR>,
				<&gcc GCC_USB3_PHY_PRIM_BCR>;
			reset-names = "phy", "common";
			#clock-cells = <1>;
			#phy-cells = <1>;
			orientation-switch;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					endpoint {
					};
				};
				port@1 {
					reg = <1>;
					usb_1_qmp_ss_in: endpoint {
						remote-endpoint =
							<&usb_1_dwc3_hs_out>;
					};
				};
				port@2 {
					reg = <2>;
					endpoint {
					};
				};
			};
		};
		usb_1: usb@a6f8800 {
			compatible = "qcom,sm7250-dwc3", "qcom,dwc3";
			reg = <0 0xa6f8800 0 0x400>;
			status = "disabled";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			dma-ranges;
			clocks =
				<&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
				<&gcc GCC_USB30_PRIM_MASTER_CLK>,
				<&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>,
				<&gcc GCC_USB30_PRIM_SLEEP_CLK>,
				<&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>,
				<&gcc GCC_USB3_PRIM_CLKREF_CLK>;
			clock-names =
				"cfg_noc",
				"core",
				"iface",
				"sleep",
				"mock_utmi",
				"xo";
			assigned-clocks =
				<&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>,
				<&gcc GCC_USB30_PRIM_MASTER_CLK>;
			assigned-clock-rates = <0x124f800 0xbebc200>;
			interrupts-extended =
				<&intc 0 144 4>,
				<&intc 0 145 4>,
				<&pdc 14 3>,
				<&pdc 15 3>,
				<&pdc 9 4>;
			interrupt-names =
				"pwr_event",
				"hs_phy_irq",
				"dp_hs_phy_irq",
				"dm_hs_phy_irq",
				"ss_phy_irq";
			power-domains = <&gcc USB30_PRIM_GDSC>;
			wakeup-source;
			resets = <&gcc GCC_USB30_PRIM_BCR>;
			qcom,select-utmi-as-pipe-clk;
			usb_1_dwc3: usb@a600000 {
				compatible = "snps,dwc3";
				reg = <0 0xa600000 0 0xcd00>;
				interrupts = <0 240 4>;
				iommus = <&apps_smmu 224 0>;
				snps,dis_u2_susphy_quirk;
				snps,dis_enblslpm_quirk;
				snps,has-lpm-erratum;
				snps,hird-threshold = [10];
				tx-fifo-resize;
				dr-mode = "peripheral";
				maximum-speed = "high-speed";
				phys = <&qusb_1_phy>;
				phy-names = "usb2-phy";
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						usb_1_dwc3_ss_out: endpoint {
						};
					};
					port@1 {
						reg = <1>;
						usb_1_dwc3_hs_out: endpoint {
							remote-endpoint =
								<&usb_1_qmp_ss_in>;
						};
					};
				};
			};
		};
		adsp: remoteproc@3000000 {
			compatible =
				"qcom,sm7250-adsp-pas",
				"qcom,sm8250-adsp-pas";
			reg = <0 0x3000000 0 0x100>;
			interrupts-extended =
				<&pdc 16 4>,
				<&adsp_smp2p_in 0 4>,
				<&adsp_smp2p_in 1 4>,
				<&adsp_smp2p_in 2 4>,
				<&adsp_smp2p_in 3 4>;
			interrupt-names =
				"wdog",
				"fatal",
				"ready",
				"handover",
				"stop-ack";
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";
			power-domains =
				<&rpmhpd SC8280XP_GFX>,
				<&rpmhpd SC8280XP_LCX>;
			power-domain-names = "lcx", "lmx";
			memory-region = <&pil_adsp_mem>;
			qcom,qmp = <&spm>;
			qcom,smem-states = <&adsp_smp2p_out 0>;
			qcom,smem-state-names = "stop";
			firmware-name = "qcom/sm7250/adsp.mdt";
			status = "disabled";
			adsp_glink: glink-edge {
				interrupts-extended = <&aoss_qmp 3 0 4>;
				mboxes = <&aoss_qmp 3 0>;
				label = "lpass";
				qcom,remote-pid = <2>;
				ipa_fastrpc_qrtr: qrtr-requests {
					qcom,glink-channels = "IPCRTR";
					qcom,low-latency;
					qcom,intents =
						<0x800 5 0x2000 3 0x4400 2>;
				};
				apr: apr {
					compatible = "qcom,apr-v2";
					qcom,glink-channels = "apr_audio_svc";
					qcom,intents = <0x200 20>;
					qcom,domain = <4>;
					#address-cells = <1>;
					#size-cells = <0>;
					q6core: service@3 {
						reg = <3>;
						compatible = "qcom,q6core";
						qcom,protection-domain =
							"avs/audio",
							"msm/adsp/audio_pd";
					};
					q6afe: service@4 {
						compatible = "qcom,q6afe";
						reg = <4>;
						qcom,protection-domain =
							"avs/audio",
							"msm/adsp/audio_pd";
						q6afedai: dais {
							compatible =
								"qcom,q6afe-dais";
							#address-cells = <1>;
							#size-cells = <0>;
							#sound-dai-cells = <1>;
						};
						q6afecc: clock-controller {
							compatible =
								"qcom,q6afe-clocks";
							#clock-cells = <2>;
						};
					};
					q6asm: service@7 {
						compatible = "qcom,q6asm";
						reg = <7>;
						qcom,protection-domain =
							"avs/audio",
							"msm/adsp/audio_pd";
						q6asmdai: dais {
							compatible =
								"qcom,q6asm-dais";
							#address-cells = <1>;
							#size-cells = <0>;
							#sound-dai-cells = <1>;
							iommus =
								<&apps_smmu 0x1401 0>;
							dai@0 {
								reg = <0>;
							};
							dai@1 {
								reg = <1>;
							};
							dai@2 {
								reg = <2>;
							};
						};
					};
					q6adm: service@8 {
						compatible = "qcom,q6adm";
						reg = <8>;
						qcom,protection-domain =
							"avs/audio",
							"msm/adsp/audio_pd";
						q6routing: routing {
							compatible =
								"qcom,q6adm-routing";
							#sound-dai-cells = <0>;
						};
					};
				};
				fastrpc: fastrpc {
					compatible = "qcom,fastrpc";
					qcom,glink-channels =
						"fastrpcglink-apps-dsp";
					label = "adsp";
					qcom,non-secure-domain;
					#address-cells = <1>;
					#size-cells = <0>;
					compute-cb@3 {
						compatible =
							"qcom,fastrpc-compute-cb";
						reg = <3>;
						iommus = <&apps_smmu 0x1403 0>;
					};
					compute-cb@4 {
						compatible =
							"qcom,fastrpc-compute-cb";
						reg = <4>;
						iommus = <&apps_smmu 0x1404 0>;
					};
					compute-cb@5 {
						compatible =
							"qcom,fastrpc-compute-cb";
						reg = <5>;
						iommus = <&apps_smmu 0x1405 0>;
						qcom,nsessions = <5>;
					};
				};
				glink_ssr: glink-ssr {
					qcom,glink-channels = "glink_ssr";
				};
			};
		};
		vamacro: codec@3370000 {
			compatible = "qcom,sm8250-lpass-va-macro";
			reg = <0 0x3370000 0 0x1000>;
			qcom,dmic-sample-rate = <0x927c0>;
			vdd-micb-supply = <&vreg_bob>;
			clocks = <&q6afecc 57 1 &q6afecc 102 1 &q6afecc 103 1>;
			clock-names = "mclk", "macro", "dcodec";
			#clock-cells = <0>;
			clock-output-names = "fsgen";
			#sound-dai-cells = <1>;
			status = "okay";
		};
		rxmacro: rxmacro@3200000 {
			compatible = "qcom,sm8250-lpass-rx-macro";
			reg = <0 0x3200000 0 0x1000>;
			pinctrl-names = "default";
			pinctrl-0 = <&rx_swr_active>;
			clocks =
				<&q6afecc 59 1>,
				<&q6afecc 60 1>,
				<&q6afecc 102 1>,
				<&q6afecc 103 1>,
				<&vamacro>;
			clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
			#clock-cells = <0>;
			clock-output-names = "mclk";
			#sound-dai-cells = <1>;
			status = "okay";
		};
		swr1: soundwire@3210000 {
			compatible = "qcom,soundwire-v1.5.1";
			reg = <0 0x3210000 0 0x2000>;
			interrupts = <0 155 4>;
			clocks = <&rxmacro>;
			clock-names = "iface";
			label = "RX";
			qcom,din-ports = <0>;
			qcom,dout-ports = <5>;
			qcom,ports-sinterval-low = /bits/ 8 <3 31 31 7 0>;
			qcom,ports-offset1 = /bits/ 8 <0 0 11 1 0>;
			qcom,ports-offset2 = /bits/ 8 <0 0 11 0 0>;
			qcom,ports-hstart = /bits/ 8 <255 3 255 255 255>;
			qcom,ports-hstop = /bits/ 8 <255 6 255 255 255>;
			qcom,ports-word-length = /bits/ 8 <1 7 4 255 255>;
			qcom,ports-block-pack-mode = /bits/ 8 <255 0 1 255 255>;
			qcom,ports-lane-control = /bits/ 8 <1 0 0 0 0>;
			qcom,ports-block-group-count = /bits/ 8 <255 255 255 255 0>;
			#sound-dai-cells = <1>;
			#address-cells = <2>;
			#size-cells = <0>;
			status = "okay";
			wcd9385_rx: wcd9385-rx@0,4 {
				compatible = "sdw20217010d00";
				reg = <0 4>;
				qcom,rx-port-mapping = <1 2 3 4 5>;
			};
		};
		txmacro: txmacro@3220000 {
			compatible = "qcom,sm8250-lpass-tx-macro";
			reg = <0 0x3220000 0 0x1000>;
			pinctrl-names = "default";
			pinctrl-0 = <&tx_swr_active>;
			clocks =
				<&q6afecc 57 1>,
				<&q6afecc 58 1>,
				<&q6afecc 102 1>,
				<&q6afecc 103 1>,
				<&vamacro>;
			clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
			#clock-cells = <0>;
			clock-output-names = "mclk";
			#sound-dai-cells = <1>;
			status = "okay";
		};
		swr2: soundwire@3230000 {
			compatible = "qcom,soundwire-v1.5.1";
			reg = <0 0x3230000 0 0x2000>;
			interrupts = <0 166 4>;
			clocks = <&txmacro>;
			clock-names = "iface";
			label = "TX";
			qcom,din-ports = <5>;
			qcom,dout-ports = <0>;
			qcom,ports-sinterval-low = /bits/ 8 <255 1 1 3 3>;
			qcom,ports-offset1 = /bits/ 8 <255 1 0 2 0>;
			qcom,ports-offset2 = /bits/ 8 <255 0 0 0 0>;
			qcom,ports-block-pack-mode = /bits/ 8 <255 255 255 255 255>;
			qcom,ports-hstart = /bits/ 8 <255 255 255 255 255>;
			qcom,ports-hstop = /bits/ 8 <255 255 255 255 255>;
			qcom,ports-word-length = /bits/ 8 <255 255 255 255 255>;
			qcom,ports-block-group-count = /bits/ 8 <255 255 255 255 255>;
			qcom,ports-lane-control = /bits/ 8 <255 0 1 0 1>;
			#sound-dai-cells = <1>;
			#address-cells = <2>;
			#size-cells = <0>;
			status = "okay";
			wcd9385_tx: wcd9385-tx@0,3 {
				compatible = "sdw20217010d00";
				reg = <0 3>;
				qcom,tx-port-mapping = <2 3 4 5>;
			};
		};
		lpass_tlmm: pinctrl@33c0000 {
			compatible = "qcom,sm8250-lpass-lpi-pinctrl";
			reg = <0 0x33c0000 0 0x20000 0 0x3550000 0 0x10000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&lpass_tlmm 0 0 &cpu_pd4>;
			clocks = <&q6afecc 102 1 &q6afecc 103 1>;
			clock-names = "core", "audio";
			status = "okay";
			rx_swr_active: rx-swr-active-state {
				clk-pins {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <2>;
					slew-rate = <1>;
					bias-disable;
				};
				data-pins {
					pins = "gpio4", "gpio5";
					function = "swr_rx_data";
					drive-strength = <2>;
					slew-rate = <1>;
					bias-bus-hold;
				};
			};
			tx_swr_active: tx-swr-active-state {
				clk-pins {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <2>;
					slew-rate = <1>;
					bias-disable;
				};
				data-pins {
					pins = "gpio1", "gpio2";
					function = "swr_tx_data";
					drive-strength = <2>;
					slew-rate = <1>;
					bias-bus-hold;
				};
			};
		};
		gpucc: clock-controller@3d90000 {
			compatible = "qcom,sm7250-gpucc";
			reg = <0 0x3d90000 0 0x9000>;
			/* 0x2a=gcc：161/162 = gcc_gpu_gpll0(_div)_clk_src（gmu RCG 父时钟） */
			clocks =
				<&rpmhcc RPMH_CXO_CLK>,
				<&gcc GCC_GPU_GPLL0_CLK_SRC>,
				<&gcc GCC_GPU_GPLL0_DIV_CLK_SRC>;
			clock-names =
				"bi_tcxo",
				"gcc_gpu_gpll0_clk_src",
				"gcc_gpu_gpll0_div_clk_src";
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
			status = "okay";
		};
		gpu_smmu: iommu@3da0000 {
			/* gpucc 提供 CX GDSC（0x50 0），probe 前先上电避免读挂 */
			power-domains = <&gpucc GPU_CX_GDSC>;
			/* 迭代 25 审计：补 ahb/bus/iface 三时钟 + dma-coherent
						   （上游 sm8250 模板同款；缺 AHB 时钟时 CX 域 off/on 循环
						   后寄存器访问会挂——此前仅靠 ABL 残留态工作）。
						   ahb=gpucc[2] GPU_CC_AHB_CLK、bus=gcc[140] MEMNOC_GFX、
						   iface=gcc[141] SNOC_DVM_GFX（gcc 偏移已对下游逐字审计） */
			clocks =
				<&gpucc GPU_CC_AHB_CLK>,
				<&gcc GCC_GPU_MEMNOC_GFX_CLK>,
				<&gcc GCC_GPU_SNOC_DVM_GFX_CLK>;
			clock-names = "ahb", "bus", "iface";
			dma-coherent;
			status = "okay";
			compatible =
				"qcom,sm7250-smmu-500",
				"qcom,adreno-smmu",
				"qcom,smmu-500",
				"arm,mmu-500";
			reg = <0 0x3da0000 0 0x10000>;
			#iommu-cells = <2>;
			#global-interrupts = <1>;
			interrupts =
				<0 0x2a1 4 0 0x2a6 4 0 0x2a7 4 0 0x2a8 4 0 0x2a9 4 0 0x2aa 4 0>,
				<0x2ab 4 0 0x2ac 4 0 0x2ad 4>;
		};
		gpu: gpu@3d00000 {
			compatible = "qcom,adreno-620.2", "qcom,adreno";
			reg =
				<0 0x3d00000 0 0x40000 0 0x3d61000 0 0x800 0 0x3d8b000 0 0x2000>;
			reg-names =
				"kgsl_3d0_reg_memory",
				"cx_dbgc",
				"isense_cntl";
			interrupts = <0 0x12c 4>;
			iommus = <&gpu_smmu 0 0x401>;
			operating-points-v2 = <&gpu_opp_table>;
			qcom,gmu = <&gmu>;
			nvmem-cells =
				<&gpu_speed_bin>,
				<&gpu_gaming_bin>,
				<&gpu_lm_efuse>;
			nvmem-cell-names =
				"speed_bin",
				"gaming_bin",
				"isense_slope";
			/*
						 * Mainline GMU consumes one peak-bandwidth path and converts it
						 * to the SH0/MC0/ACV RPMh BCM votes carried in HFI.
						 */
			interconnects = <&gem_noc 9 0 &mc_virt 1 0>;
			interconnect-names = "gfx-mem";
			/*
						 * Full live-DTS grp3d table.  The default OPP bandwidth is
						 * adjusted independently within each OPP's min/max range.
						 */
			qcom,gpu-bw-levels-kBps =
				<0 0x61a80 0xc3500 0x124f80 0x1b8a00 0x2162e0 0x2990a0 0x2ee000>,
				<0x3e12a0 0x5294a0 0x5ee8e0 0x6e1b80 0x7fbc00>;
			#cooling-cells = <2>;
			status = "disabled";
			zap_shader: zap-shader {
				memory-region = <&pil_gpu_mem>;
			};
			gpu_opp_table: opp-table {
				compatible =
					"operating-points-v2-adreno",
					"operating-points-v2";
				gpu_opp_750mhz: opp-750000000 {
					opp-hz = <0 0x2cb41780>;
					opp-level = <0x180>;
					opp-peak-kBps = <0x5ee8e0>;
					qcom,opp-bw-min-kBps = <0x5294a0>;
					qcom,opp-bw-max-kBps = <0x7fbc00>;
					qcom,opp-acd-level = <0xa02c5ffd>;
					opp-supported-hw = <8>;
				};
				gpu_opp_670mhz: opp-670000000 {
					opp-hz = <0 0x27ef6380>;
					opp-level = <0x140>;
					opp-peak-kBps = <0x5ee8e0>;
					qcom,opp-bw-min-kBps = <0x5294a0>;
					qcom,opp-bw-max-kBps = <0x7fbc00>;
					qcom,opp-acd-level = <0xa02c5ffd>;
					opp-supported-hw = <8>;
				};
				gpu_opp_625mhz_0: opp-625000000-0 {
					/* ACD characterization differs between legacy and v2 bins. */
					opp-hz = <0 0x2540be40>;
					opp-level = <0x100>;
					opp-peak-kBps = <0x5ee8e0>;
					qcom,opp-bw-min-kBps = <0x5294a0>;
					qcom,opp-bw-max-kBps = <0x7fbc00>;
					qcom,opp-acd-level = <0x802c5ffd>;
					opp-supported-hw = <3>;
				};
				gpu_opp_625mhz_1: opp-625000000-1 {
					opp-hz = <0 0x2540be40>;
					opp-level = <0x100>;
					opp-peak-kBps = <0x5ee8e0>;
					qcom,opp-bw-min-kBps = <0x5294a0>;
					qcom,opp-bw-max-kBps = <0x7fbc00>;
					qcom,opp-acd-level = <0x802d5ffd>;
					opp-supported-hw = <24>;
				};
				gpu_opp_540mhz: opp-540000000 {
					opp-hz = <0 0x202fbf00>;
					opp-level = <0x100>;
					opp-peak-kBps = <0x3e12a0>;
					qcom,opp-bw-min-kBps = <0x2ee000>;
					qcom,opp-bw-max-kBps = <0x7fbc00>;
					qcom,opp-acd-level = <0x802c5ffd>;
					opp-supported-hw = <4>;
				};
				gpu_opp_500mhz_0: opp-500000000-0 {
					opp-hz = <0 0x1dcd6500>;
					opp-level = <224>;
					opp-peak-kBps = <0x3e12a0>;
					qcom,opp-bw-min-kBps = <0x2ee000>;
					qcom,opp-bw-max-kBps = <0x5ee8e0>;
					qcom,opp-acd-level = <0xa02c5ffd>;
					opp-supported-hw = <3>;
				};
				gpu_opp_500mhz_1: opp-500000000-1 {
					opp-hz = <0 0x1dcd6500>;
					opp-level = <224>;
					opp-peak-kBps = <0x3e12a0>;
					qcom,opp-bw-min-kBps = <0x2ee000>;
					qcom,opp-bw-max-kBps = <0x5ee8e0>;
					qcom,opp-acd-level = <0xa02d5ffd>;
					opp-supported-hw = <24>;
				};
				gpu_opp_400mhz_0: opp-400000000-0 {
					opp-hz = <0 0x17d78400>;
					opp-level = <192>;
					opp-peak-kBps = <0x2ee000>;
					qcom,opp-bw-min-kBps = <0x2162e0>;
					qcom,opp-bw-max-kBps = <0x3e12a0>;
					qcom,opp-acd-level = <0xa02c5ffd>;
					opp-supported-hw = <7>;
				};
				gpu_opp_400mhz_1: opp-400000000-1 {
					opp-hz = <0 0x17d78400>;
					opp-level = <192>;
					opp-peak-kBps = <0x2ee000>;
					qcom,opp-bw-min-kBps = <0x2162e0>;
					qcom,opp-bw-max-kBps = <0x3e12a0>;
					qcom,opp-acd-level = <0x802e5ffd>;
					opp-supported-hw = <24>;
				};
				gpu_opp_275mhz: opp-275000000 {
					opp-hz = <0 0x10642ac0>;
					opp-level = <128>;
					opp-peak-kBps = <0x2162e0>;
					qcom,opp-bw-min-kBps = <0x2162e0>;
					qcom,opp-bw-max-kBps = <0x2ee000>;
					qcom,opp-acd-level = <0x802f5ffd>;
					opp-supported-hw = <31>;
				};
				gpu_opp_150mhz: opp-150000000 {
					opp-hz = <0 0x8f0d180>;
					opp-level = <64>;
					opp-peak-kBps = <0x1b8a00>;
					qcom,opp-bw-min-kBps = <0x1b8a00>;
					qcom,opp-bw-max-kBps = <0x2990a0>;
					qcom,opp-acd-level = <0x802f5ffd>;
					opp-supported-hw = <7>;
				};
			};
		};
		gmu: gmu@3d6a000 {
			compatible = "qcom,adreno-gmu-620.2", "qcom,adreno-gmu";
			reg =
				<0 0x3d6a000 0 0x30000 0 0x3de0000 0 0x10000 0 0xb290000 0 0x10000>,
				<0 0xb490000 0 0x10000>;
			reg-names = "gmu", "rscc", "gmu_pdc", "gmu_pdc_seq";
			interrupts = <0 0x130 4 0 0x131 4>;
			interrupt-names = "hfi", "gmu";
			clocks =
				<&gpucc GPU_CC_AHB_CLK>,
				<&gpucc GPU_CC_CX_GMU_CLK>,
				<&gpucc GPU_CC_CXO_CLK>,
				<&gcc GCC_DDRSS_GPU_AXI_CLK>,
				<&gcc GCC_GPU_MEMNOC_GFX_CLK>;
			clock-names = "ahb", "gmu", "cxo", "axi", "memnoc";
			power-domains = <&gpucc GPU_CX_GDSC &gpucc GPU_GX_GDSC>;
			power-domain-names = "cx", "gx";
			iommus = <&gpu_smmu 5 0x400>;
			qcom,qmp = <&spm>;
			operating-points-v2 = <&gmu_opp_table>;
			status = "disabled";
			gmu_opp_table: opp-table {
				compatible = "operating-points-v2";
				gmu_opp_200mhz: opp-200000000 {
					opp-hz = <0 0xbebc200>;
					opp-level = <48>;
				};
			};
		};
		mdss: display-subsystem@ae00000 {
			compatible = "qcom,sm7250-mdss";
			reg = <0 0xae00000 0 0x1000>;
			reg-names = "mdss";
			power-domains = <&dispcc MDSS_GDSC>;
			clocks =
				<&dispcc DISP_CC_MDSS_AHB_CLK>,
				<&gcc GCC_DISP_HF_AXI_CLK>,
				<&gcc GCC_DISP_SF_AXI_CLK>,
				<&dispcc DISP_CC_MDSS_MDP_CLK>;
			clock-names = "iface", "bus", "nrt_bus", "core";
			interrupts = <0 83 4>;
			interrupt-controller;
			#interrupt-cells = <1>;
			iommus = <&apps_smmu 0xb40 0x402>;
			resets = <&dispcc DISP_CC_MDSS_CORE_BCR>;
			/* 显示链路已就绪：dispcc-sm7250 驱动 + DPU 6.1 catalog +
						   G7A 面板驱动 + LCDB bias（0x52=dispcc phandle，0=MDSS_GDSC）。
						   迭代 25 恢复使能：GPU 链已修（catalog 0x06020002 + GMU/zap
						   固件入 initramfs），modeset 挂死疑因无 GPU（fix20 判断） */
			status = "disabled";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			mdp: display-controller@ae01000 {
				compatible = "qcom,sm7250-dpu";
				reg =
					<0 0xae01000 0 0x84000 0 0xaeb0000 0 0x2008>;
				reg-names = "mdp", "vbif";
				clocks =
					<&dispcc DISP_CC_MDSS_AHB_CLK>,
					<&gcc GCC_DISP_HF_AXI_CLK>,
					<&dispcc DISP_CC_MDSS_MDP_CLK>,
					<&dispcc DISP_CC_MDSS_VSYNC_CLK>;
				clock-names = "iface", "bus", "core", "vsync";
				assigned-clocks =
					<&dispcc DISP_CC_MDSS_VSYNC_CLK>;
				assigned-clock-rates = <0x124f800>;
				operating-points-v2 = <&mdp_opp_table>;
				/* lito cmd-db 无 mmcx（sm7150 集无此域），显示走 CX（同 sm6350） */
				power-domains = <&rpmhpd SC8280XP_CX>;
				interrupt-parent = <&mdss>;
				interrupts = <0>;
				status = "disabled";
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						mdp_out_dsi0: endpoint {
							remote-endpoint =
								<&dsi0_in>;
						};
					};
				};
				mdp_opp_table: opp-table {
					compatible = "operating-points-v2";
					mdp_opp_200mhz: opp-200000000 {
						opp-hz = <0 0xbebc200>;
						required-opps =
							<&rpmhpd_opp_low_svs>;
					};
					mdp_opp_300mhz: opp-300000000 {
						opp-hz = <0 0x11e1a300>;
						required-opps =
							<&rpmhpd_opp_svs>;
					};
					mdp_opp_345mhz: opp-345000000 {
						opp-hz = <0 0x14904840>;
						required-opps =
							<&rpmhpd_opp_svs_l1>;
					};
					mdp_opp_460mhz: opp-460000000 {
						opp-hz = <0 0x1b6b0b00>;
						required-opps =
							<&rpmhpd_opp_nom>;
					};
				};
			};
			dsi0: dsi@ae94000 {
				compatible =
					"qcom,sm7250-dsi-ctrl",
					"qcom,mdss-dsi-ctrl";
				reg = <0 0xae94000 0 0x400>;
				reg-names = "dsi_ctrl";
				interrupt-parent = <&mdss>;
				interrupts = <4>;
				/* 迭代 25-fix4：补 byte_src/pixel_src/dsi_pll_byte/
								   dsi_pll_pixel 四个时钟引用（驱动侧可选 get）——
								   assigned-clock-parents 在 probe 阶段 reparent -22
								   失败后无人重试，改走 power_on 时显式 reparent
								   （上游 v2.9 同方案）。0x52[9]=BYTE0_CLK_SRC、
								   0x52[a]=PCLK0_CLK_SRC；0x59[0/1]=PHY byte/pixel */
				clocks =
					<&dispcc DISP_CC_MDSS_BYTE0_CLK>,
					<&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>,
					<&dispcc DISP_CC_MDSS_PCLK0_CLK>,
					<&dispcc DISP_CC_MDSS_ESC0_CLK>,
					<&dispcc DISP_CC_MDSS_AHB_CLK>,
					<&gcc GCC_DISP_HF_AXI_CLK>,
					<&dispcc DISP_CC_MDSS_BYTE0_CLK_SRC>,
					<&dsi0_phy 0>,
					<&dispcc DISP_CC_MDSS_PCLK0_CLK_SRC>,
					<&dsi0_phy 1>;
				clock-names =
					"byte",
					"byte_intf",
					"pixel",
					"core",
					"iface",
					"bus",
					"byte_src",
					"dsi_pll_byte",
					"pixel_src",
					"dsi_pll_pixel";
				assigned-clocks =
					<&dispcc DISP_CC_MDSS_BYTE0_CLK_SRC>,
					<&dispcc DISP_CC_MDSS_PCLK0_CLK_SRC>;
				assigned-clock-parents =
					<&dsi0_phy 0>,
					<&dsi0_phy 1>;
				operating-points-v2 = <&dsi0_opp_table>;
				/* msm_dsi_6g_v2 需 vdda+refgen（非可选）；CX 域（无 MMCX） */
				power-domains = <&rpmhpd SC8280XP_CX>;
				refgen-supply = <&refgen>;
				phys = <&dsi0_phy>;
				phy-names = "dsi";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						dsi0_in: endpoint {
							remote-endpoint =
								<&mdp_out_dsi0>;
						};
					};
					port@1 {
						reg = <1>;
						dsi0_out: endpoint {
							data-lanes = <0 1 2 3>;
							remote-endpoint =
								<&panel_in_dsi0>;
						};
					};
				};
				dsi0_opp_table: opp-table {
					compatible = "operating-points-v2";
					dsi0_opp_187mhz: opp-187500000 {
						opp-hz = <0 0xb2d05e0>;
						required-opps =
							<&rpmhpd_opp_low_svs>;
					};
					dsi0_opp_300mhz: opp-300000000 {
						opp-hz = <0 0x11e1a300>;
						required-opps =
							<&rpmhpd_opp_svs>;
					};
					dsi0_opp_358mhz: opp-358000000 {
						opp-hz = <0 0x1556a580>;
						required-opps =
							<&rpmhpd_opp_svs_l1>;
					};
				};
			};
			dsi0_phy: phy@ae94400 {
				/* 主线通用 7nm PHY（v4.1，= 下游 dsi-phy-v4.1）；
								   vdds = PM8150 ldo5 0.88V（0x43，下游 vdda-0p9） */
				compatible = "qcom,dsi-phy-7nm";
				reg =
					<0 0xae94400 0 0x200 0 0xae94600 0 0x280 0 0xae94900 0 0x260>;
				reg-names =
					"dsi_phy",
					"dsi_phy_lane",
					"dsi_pll";
				#clock-cells = <1>;
				#phy-cells = <0>;
				clocks =
					<&dispcc DISP_CC_MDSS_AHB_CLK>,
					<&rpmhcc RPMH_CXO_CLK>;
				clock-names = "iface", "ref";
				status = "disabled";
			};
		};
		dispcc: clock-controller@af00000 {
			compatible = "qcom,sm7250-dispcc";
			reg = <0 0xaf00000 0 0x10000>;
			/* 显示时钟走 CX（下游 dispcc vdd_cx）；0x26=rpmhpd low_svs opp */
			power-domains = <&rpmhpd SC8280XP_CX>;
			required-opps = <&rpmhpd_opp_low_svs>;
			/* 输入：bi_tcxo(rpmhcc) + sleep_clk + GPLL0 分支(gcc 0xa0)
						   + DSI0 PHY byte/pixel PLL（0x59） */
			/* sleep_clk(#clock-cells=0) 引用必须单个 u32；原误写 <0x29 0x00> 的
						   多余 0 运行时成为无效 phandle 条目，其后条目索引全部 +1
						   （byte0_src 的 DSI PLL parent 错位到 gpll0 的根因，fix6） */
			clocks =
				<&rpmhcc RPMH_CXO_CLK>,
				<&sleep_clk>,
				<&gcc GCC_DISP_GPLL0_CLK_SRC>,
				<&dsi0_phy 0>,
				<&dsi0_phy 1>;
			clock-names =
				"bi_tcxo",
				"sleep_clk",
				"gcc_disp_gpll0_clk_src",
				"dsi0_phy_pll_out_byteclk",
				"dsi0_phy_pll_out_dsiclk";
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
		};
	};
	firmware {
		scm: scm {
			compatible = "qcom,scm-sm7250", "qcom,scm";
			#reset-cells = <1>;
		};
	};
	timer {
		compatible = "arm,armv8-timer";
		interrupts = <1 1 0xff08 1 2 0xff08 1 3 0xff08 1 0 0xff08>;
		clock-frequency = <0x124f800>;
	};
	thermal-zones {
		cpu0-thermal {
			polling-delay-passive = <250>;
			polling-delay = <0>;
			thermal-sensors = <&tsens0 1>;
			trips {
				cpu0_alert0: trip-point0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
