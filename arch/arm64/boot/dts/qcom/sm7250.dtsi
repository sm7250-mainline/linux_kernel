				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c4_default>;
				interrupts = <0 0x25d 4>;
				dmas = <&gpi_dma0 0 4 3 &gpi_dma0 1 4 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
