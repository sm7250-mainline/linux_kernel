#include <dt-bindings/clock/qcom,rpmh.h>
#include <dt-bindings/clock/qcom,sm7250-gcc.h>
#include <dt-bindings/clock/qcom,dispcc-sm7250.h>
#include <dt-bindings/clock/qcom,gpucc-sm7250.h>
#include <dt-bindings/power/qcom,rpmhpd.h>

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>


/ {
	interrupt-parent = <&intc>;
	#address-cells = <2>;
	#size-cells = <2>;
	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0x249f000>;
			clock-output-names = "xo_board";
		};
		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0x7d00>;
			clock-output-names = "sleep_clk";
		};
	};
	cpus {
		#address-cells = <2>;
		#size-cells = <0>;
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <166>;
			next-level-cache = <&l2_0>;
			power-domains = <&cpu_pd0>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 0>;
			#cooling-cells = <2>;
			l2_0: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
				l3_0: l3-cache {
					compatible = "cache";
					cache-level = <3>;
					cache-unified;
				};
			};
		};
		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <166>;
			next-level-cache = <&l2_100>;
			power-domains = <&cpu_pd1>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 0>;
			#cooling-cells = <2>;
			l2_100: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
			};
		};
		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <166>;
			next-level-cache = <&l2_200>;
			power-domains = <&cpu_pd2>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 0>;
			#cooling-cells = <2>;
			l2_200: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
			};
		};
		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <166>;
			next-level-cache = <&l2_300>;
			power-domains = <&cpu_pd3>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 0>;
			#cooling-cells = <2>;
			l2_300: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
			};
		};
		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <166>;
			next-level-cache = <&l2_400>;
			power-domains = <&cpu_pd4>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 0>;
			#cooling-cells = <2>;
			l2_400: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
			};
		};
		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <166>;
			next-level-cache = <&l2_500>;
			power-domains = <&cpu_pd5>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 0>;
			#cooling-cells = <2>;
			l2_500: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
			};
		};
		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x189>;
			next-level-cache = <&l2_600>;
			power-domains = <&cpu_pd6>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 1>;
			#cooling-cells = <2>;
			l2_600: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
			};
		};
		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo475";
			reg = <0 0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x1ac>;
			next-level-cache = <&l2_700>;
			power-domains = <&cpu_pd7>;
			power-domain-names = "psci";
			qcom,freq-domain = <&cpufreq_hw 2>;
			#cooling-cells = <2>;
			l2_700: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&l3_0>;
			};
		};
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
				core4 {
					cpu = <&cpu4>;
				};
				core5 {
					cpu = <&cpu5>;
				};
			};
			cluster1 {
				core0 {
					cpu = <&cpu6>;
				};
			};
			cluster2 {
				core0 {
					cpu = <&cpu7>;
				};
			};
		};
		idle-states {
			entry-method = "psci";
			cpu_sleep_0_0: cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "little-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x2be>;
				exit-latency-us = <0x393>;
				min-residency-us = <0xfa1>;
				local-timer-stop;
			};
			cpu_sleep_1_0: cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "big-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x20e>;
				exit-latency-us = <0x73e>;
				min-residency-us = <0x15b3>;
				local-timer-stop;
			};
			cluster_sleep_0_0: cluster-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "cluster-power-collapse";
				arm,psci-suspend-param = <0x4100c244>;
				entry-latency-us = <0xcbf>;
				exit-latency-us = <0x19a2>;
				min-residency-us = <0x2662>;
				local-timer-stop;
			};
		};
	};
	memory: memory@80000000 {
		device_type = "memory";
		reg =
			<0 0x80000000 0 0x3cc00000 0 0xc0000000 0 0x40000000 1 0 1 0>;
	};
	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <1 7 8>;
	};
	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
		cpu_pd0: power-domain-cpu0 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_0_0>;
		};
		cpu_pd1: power-domain-cpu1 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_0_0>;
		};
		cpu_pd2: power-domain-cpu2 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_0_0>;
		};
		cpu_pd3: power-domain-cpu3 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_0_0>;
		};
		cpu_pd4: power-domain-cpu4 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_0_0>;
		};
		cpu_pd5: power-domain-cpu5 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_0_0>;
		};
		cpu_pd6: power-domain-cpu6 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_1_0>;
		};
		cpu_pd7: power-domain-cpu7 {
			#power-domain-cells = <0>;
			power-domains = <&cluster_pd>;
			domain-idle-states = <&cpu_sleep_1_0>;
		};
		cluster_pd: power-domain-cpu-cluster0 {
			#power-domain-cells = <0>;
			domain-idle-states = <&cluster_sleep_0_0>;
		};
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		memory@80000000 {
			reg = <0 0x80000000 0 0x600000>;
			no-map;
		};
		xbl_aop_mem: memory@80600000 {
			/* live dts: xbl_aop_region 实为 0x80600000+0x260000，此前少保留 0x80600000-0x80700000 */
			reg = <0 0x80600000 0 0x260000>;
			no-map;
		};
		cmd_db: memory@80860000 {
			compatible = "qcom,cmd-db";
			reg = <0 0x80860000 0 0x20000>;
			no-map;
		};
		xbl_uefi_log_mem: memory@80880000 {
			/* live dts: res_xbl_uefi_log_region */
			reg = <0 0x80880000 0 0x14000>;
			no-map;
		};
		smem_mem: memory@80900000 {
			reg = <0 0x80900000 0 0x200000>;
			no-map;
		};
		removed_mem: memory@80b00000 {
			reg = <0 0x80b00000 0 0x1300000>;
			no-map;
		};
		sec_apps_mem: memory@808ff000 {
			reg = <0 0x808ff000 0 0x1000>;
			no-map;
		};
		qtee_apps_mem: memory@81e00000 {
			reg = <0 0x81e00000 0 0x4200000>;
			no-map;
		};
		pil_camera_mem: memory@86000000 {
			reg = <0 0x86000000 0 0x500000>;
			no-map;
		};
		pil_npu_mem: memory@86500000 {
			reg = <0 0x86500000 0 0x500000>;
			no-map;
		};
		pil_video_mem: memory@86a00000 {
			reg = <0 0x86a00000 0 0x500000>;
			no-map;
		};
		pil_cdsp_mem: memory@87400000 {
			reg = <0 0x87400000 0 0x1e00000>;
			no-map;
		};
		pil_wlan_mem: memory@8ba00000 {
			reg = <0 0x8ba00000 0 0x200000>;
			no-map;
		};
		pil_ipa_fw_mem: memory@8bc00000 {
			reg = <0 0x8bc00000 0 0x10000>;
			no-map;
		};
		pil_ipa_gsi_mem: memory@8bc10000 {
			reg = <0 0x8bc10000 0 0x5400>;
			no-map;
		};
		pil_adsp_mem: memory@89200000 {
			reg = <0 0x89200000 0 0x2800000>;
			no-map;
		};
		modem_wlan_mem: memory@8c000000 {
			reg = <0 0x8c000000 0 0xf800000>;
			no-map;
		};
		cdsp_sec_mem: memory@9f400000 {
			reg = <0 0x9f400000 0 0xc00000>;
			no-map;
		};
		pil_gpu_mem: pil-gpu-mem@8bc15400 {
			reg = <0 0x8bc15400 0 0x2000>;
			no-map;
		};
		reserved_pil_mem: memory@8bc17400 {
			/* live dts: reserved_pil_mem_region，补齐 0x8bc17400-0x8c000000 空洞 */
			reg = <0 0x8bc17400 0 0x3e8c00>;
			no-map;
		};
	};
	smem: smem {
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
		hwlocks = <&tcsr_mutex 3>;
	};
	smp2p_adsp: smp2p-adsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1bb 0x1ad>;
		interrupts-extended = <&aoss_qmp 3 2 4>;
		mboxes = <&aoss_qmp 3 2>;
		qcom,local-pid = <0>;
		qcom,remote-pid = <2>;
		adsp_smp2p_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <1>;
		};
		adsp_smp2p_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
		sleepstate_smp2p_out: sleepstate {
			qcom,entry-name = "sleepstate";
			#qcom,smem-state-cells = <1>;
		};
		sleepstate_smp2p_in: sleepstate-see {
			qcom,entry-name = "sleepstate_see";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
	qup_opp_table: opp-table-qup {
		compatible = "operating-points-v2";
		qup_opp_50mhz: opp-50000000 {
			opp-hz = <0 0x2faf080>;
			required-opps = <&rpmhpd_opp_min_svs>;
		};
		qup_opp_75mhz: opp-75000000 {
			opp-hz = <0 0x47868c0>;
			required-opps = <&rpmhpd_opp_low_svs>;
		};
		qup_opp_120mhz: opp-120000000 {
			opp-hz = <0 0x7270e00>;
			required-opps = <&rpmhpd_opp_svs>;
		};
	};
	soc@0 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0 0 0 0 16 0>;
		dma-ranges = <0 0 0 0 16 0>;
		compatible = "simple-bus";
		intc: interrupt-controller@17a00000 {
			compatible = "arm,gic-v3";
			reg = <0 0x17a00000 0 0x10000 0 0x17a60000 0 0x100000>;
			#interrupt-cells = <3>;
			interrupt-controller;
			interrupts = <1 8 4>;
		};
		apss_timer: timer@17c20000 {
			compatible = "arm,armv7-timer-mem";
			reg = <0 0x17c20000 0 0x1000>;
			clock-frequency = <0x124f800>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0 0 0x20000000>;
			frame@17c21000 {
				frame-number = <0>;
				interrupts = <0 8 4 0 6 4>;
				reg = <0x17c21000 0x1000 0x17c22000 0x1000>;
			};
			frame@17c23000 {
				frame-number = <1>;
				interrupts = <0 9 4>;
				reg = <0x17c23000 0x1000>;
				status = "disabled";
			};
			frame@17c25000 {
				frame-number = <2>;
				interrupts = <0 10 4>;
				reg = <0x17c25000 0x1000>;
				status = "disabled";
			};
			frame@17c27000 {
				frame-number = <3>;
				interrupts = <0 11 4>;
				reg = <0x17c27000 0x1000>;
				status = "disabled";
			};
			frame@17c29000 {
				frame-number = <4>;
				interrupts = <0 12 4>;
				reg = <0x17c29000 0x1000>;
				status = "disabled";
			};
			frame@17c2b000 {
				frame-number = <5>;
				interrupts = <0 13 4>;
				reg = <0x17c2b000 0x1000>;
				status = "disabled";
			};
			frame@17c2d000 {
				frame-number = <6>;
				interrupts = <0 14 4>;
				reg = <0x17c2d000 0x1000>;
				status = "disabled";
			};
		};
		pdc: interrupt-controller@b220000 {
			compatible = "qcom,sm7250-pdc", "qcom,pdc";
			reg = <0 0xb220000 0 0x30000 0 0x17c000f0 0 96>;
			qcom,pdc-ranges =
				<0 0x1e0 42 42 0x264 28 70 63 1 71 0x280 15 86 0x20a 52>;
			#interrupt-cells = <2>;
			interrupt-parent = <&intc>;
			interrupt-controller;
		};
		gcc: clock-controller@100000 {
			compatible = "qcom,sm7250-gcc";
			reg = <0 0x100000 0 0x1f0000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
			clock-names = "bi_tcxo", "bi_tcxo_ao", "sleep_clk";
			clocks =
				<&rpmhcc RPMH_CXO_CLK>,
				<&rpmhcc RPMH_CXO_CLK_A>,
				<&sleep_clk>;
		};
		aoss_qmp: mailbox@408000 {
			compatible = "qcom,sm7250-ipcc", "qcom,ipcc";
			reg = <0 0x408000 0 0x1000>;
			interrupts = <0 229 4>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#mbox-cells = <2>;
		};
		qfprom: efuse@780000 {
			compatible = "qcom,sm7250-qfprom", "qcom,qfprom";
			reg = <0 0x780000 0 0x7000>;
			#address-cells = <1>;
			#size-cells = <1>;
			gpu_speed_bin: gpu-speed-bin@1ea {
				/* live 实测：reg 长度必须 2 字节（bits<5,8> 跨字节；
								   原写 0x01 被 nvmem core 判 "invalid bits" →
								   qfprom probe -22 → gpu 的 fw_devlink supplier 失败 */
				reg = <0x1ea 2>;
				bits = <5 8>;
			};
			gpu_gaming_bin: gpu-gaming-bin@212 {
				reg = <0x212 1>;
				bits = <0 1>;
			};
			gpu_lm_efuse: gpu-lm-efuse@45c8 {
				reg = <0x45c8 4>;
			};
			adsp_variant: adsp-variant@210 {
				reg = <0x213 1>;
				bits = <1 2>;
			};
		};
		rng: rng@793000 {
			compatible = "qcom,prng-ee";
			reg = <0 0x793000 0 0x1000>;
			clocks = <&gcc GCC_PRNG_AHB_CLK>;
			clock-names = "core";
		};
		tcsr_mutex: hwlock@1f40000 {
			compatible = "qcom,tcsr-mutex";
			syscon = <&tcsr_syscon 0 0x1000>;
			#hwlock-cells = <1>;
		};
		tcsr_syscon: syscon@1f40000 {
			compatible = "syscon";
			reg = <0 0x1f40000 0 0x20000>;
		};
		watchdog: watchdog@17c10000 {
			compatible = "qcom,apss-wdt-sm7250", "qcom,kpss-wdt";
			reg = <0 0x17c10000 0 0x1000>;
			interrupts = <0 0 1 0 1 1>;
			clocks = <&sleep_clk>;
		};
		pshold_restart: restart@c264000 {
			compatible = "qcom,pshold";
			reg = <0 0xc264000 0 4 0 0x1fd3000 0 4>;
			reg-names = "pshold-base", "tcsr-boot-misc-detect";
		};
		gpi_dma0: dma-controller@800000 {
			compatible =
				"qcom,sm7250-gpi-dma",
				"qcom,sdm845-gpi-dma";
			reg = <0 0x800000 0 0x60000>;
			interrupts =
				<0 244 4 0 245 4 0 246 4 0 247 4 0 248 4 0 249 4 0 250 4 0 251>,
				<4 0 252 4 0 253 4>;
			dma-channels = <10>;
			dma-channel-mask = <31>;
			iommus = <&apps_smmu 0x4f6 0>;
			#dma-cells = <3>;
			status = "disabled";
		};
		gpi_dma1: dma-controller@900000 {
			compatible =
				"qcom,sm7250-gpi-dma",
				"qcom,sdm845-gpi-dma";
			reg = <0 0x900000 0 0x60000>;
			interrupts =
				<0 0x117 4 0 0x118 4 0 0x119 4 0 0x11a 4 0 0x11b 4 0 0x11c 4 0>,
				<0x125 4 0 0x126 4 0 0x127 4 0 0x128 4>;
			dma-channels = <10>;
			dma-channel-mask = <63>;
			iommus = <&apps_smmu 54 0>;
			#dma-cells = <3>;
			status = "disabled";
		};
		qupv3_id_0: geniqup@8c0000 {
			compatible = "qcom,geni-se-qup";
			reg = <0 0x8c0000 0 0x2000>;
			clock-names = "m-ahb", "s-ahb";
			clocks =
				<&gcc GCC_QUPV3_WRAP_0_M_AHB_CLK>,
				<&gcc GCC_QUPV3_WRAP_0_S_AHB_CLK>;
			#address-cells = <2>;
			#size-cells = <2>;
			iommus = <&apps_smmu 0x4e3 0>;
			ranges;
			status = "okay";
			i2c0: i2c@880000 {
				compatible = "qcom,geni-i2c";
				reg = <0 0x880000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP0_S0_CLK>;
				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c0_default>;
				interrupts = <0 0x259 4>;
				dmas = <&gpi_dma0 0 0 3 &gpi_dma0 1 0 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			spi0: spi@880000 {
				compatible = "qcom,geni-spi";
				reg = <0 0x880000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP0_S0_CLK>;
				interrupts = <0 0x259 4>;
				dmas = <&gpi_dma0 0 0 1 &gpi_dma0 1 0 1>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
