				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c9_default>;
				interrupts = <0 0x164 4>;
				dmas = <&gpi_dma1 0 3 3 &gpi_dma1 1 3 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			spi9: spi@98c000 {
				compatible = "qcom,geni-spi";
				reg = <0 0x98c000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S3_CLK>;
				interrupts = <0 0x164 4>;
				dmas = <&gpi_dma1 0 3 1 &gpi_dma1 1 3 1>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			i2c10: i2c@990000 {
				compatible = "qcom,geni-i2c";
				reg = <0 0x990000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S4_CLK>;
				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c10_default>;
				interrupts = <0 0x165 4>;
				dmas = <&gpi_dma1 0 4 3 &gpi_dma1 1 4 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			spi10: spi@990000 {
				compatible = "qcom,geni-spi";
				reg = <0 0x990000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S4_CLK>;
				interrupts = <0 0x165 4>;
				dmas = <&gpi_dma1 0 4 1 &gpi_dma1 1 4 1>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			i2c11: i2c@994000 {
				compatible = "qcom,geni-i2c";
				reg = <0 0x994000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S5_CLK>;
				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c11_default>;
				interrupts = <0 0x166 4>;
				dmas = <&gpi_dma1 0 5 3 &gpi_dma1 1 5 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			spi11: spi@994000 {
				compatible = "qcom,geni-spi";
				reg = <0 0x994000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S5_CLK>;
				interrupts = <0 0x166 4>;
				dmas = <&gpi_dma1 0 5 1 &gpi_dma1 1 5 1>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
