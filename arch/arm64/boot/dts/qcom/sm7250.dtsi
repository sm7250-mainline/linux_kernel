				clocks = <&gcc GCC_QUPV3_WRAP0_S5_CLK>;
				interrupts = <0 0x25e 4>;
				status = "disabled";
			};
		};
		qupv3_id_1: geniqup@9c0000 {
			compatible = "qcom,geni-se-qup";
			reg = <0 0x9c0000 0 0x2000>;
			clock-names = "m-ahb", "s-ahb";
			clocks =
				<&gcc GCC_QUPV3_WRAP_1_M_AHB_CLK>,
				<&gcc GCC_QUPV3_WRAP_1_S_AHB_CLK>;
			#address-cells = <2>;
			#size-cells = <2>;
			iommus = <&apps_smmu 35 0>;
			ranges;
			/* okay：触摸 SE7 (spi@984000) 所在 wrapper（其余 SE 保持 disabled） */
			status = "okay";
			i2c6: i2c@980000 {
				compatible = "qcom,geni-i2c";
				reg = <0 0x980000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S0_CLK>;
				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c6_default>;
				interrupts = <0 0x161 4>;
				dmas = <&gpi_dma1 0 0 3 &gpi_dma1 1 0 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			spi6: spi@980000 {
				compatible = "qcom,geni-spi";
				reg = <0 0x980000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S0_CLK>;
				interrupts = <0 0x161 4>;
				dmas = <&gpi_dma1 0 0 1 &gpi_dma1 1 0 1>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			i2c7: i2c@984000 {
				compatible = "qcom,geni-i2c";
				reg = <0 0x984000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S1_CLK>;
				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c7_default>;
				interrupts = <0 0x162 4>;
				dmas = <&gpi_dma1 0 1 3 &gpi_dma1 1 1 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			spi7: spi@984000 {
				compatible = "qcom,geni-spi";
				reg = <0 0x984000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S1_CLK>;
				interrupts = <0 0x162 4>;
				#address-cells = <1>;
				#size-cells = <0>;
				/* 无 dmas：PIO（FIFO）模式——触摸报文小，免去
								   gpi_dma1+apps_smmu 链路变量（下游走 GPI，量大） */
				status = "disabled";
			};
			i2c8: i2c@988000 {
				compatible = "qcom,geni-i2c";
				reg = <0 0x988000 0 0x4000>;
				clock-names = "se";
				clocks = <&gcc GCC_QUPV3_WRAP1_S2_CLK>;
				pinctrl-names = "default";
				pinctrl-0 = <&qup_i2c8_default>;
				interrupts = <0 0x163 4>;
				dmas = <&gpi_dma1 0 2 3 &gpi_dma1 1 2 3>;
				dma-names = "tx", "rx";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
			i2c9: i2c@98c000 {
				compatible = "qcom,geni-i2c";
