		tlmm: pinctrl@f000000 {
			compatible = "qcom,sm7250-tlmm";
			/* 单段（原厂同款）：驱动把 tile 偏移并入寄存器偏移
						   （下游 4.19 同一访问算式，Android 实证） */
			reg = <0 0xf000000 0 0x1000000>;
			interrupts = <0 208 4>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
		apps_rsc: rsc@18200000 {
			/* pm7250b("b") 与虚构的 pm8150a 组已删除：
						   cmd-db 实测无 smpb、ldob 系列资源（probe 必 -ENODEV），
						   l7c(UFS vcc) 实为 PM8150L 的 ldoc7，已并入 regulators-1 */
			compatible = "qcom,rpmh-rsc";
			reg =
				<0 0x18200000 0 0x10000 0 0x18210000 0 0x10000 0 0x18220000 0 0x10000>;
			reg-names = "drv-0", "drv-1", "drv-2";
			interrupts = <0 3 4 0 4 4 0 5 4>;
			power-domains = <&cluster_pd>;
			label = "apps_rsc";
			qcom,tcs-offset = <0xd00>;
			qcom,drv-id = <2>;
			qcom,tcs-config = <2 2 0 3 1 3 3 1>;
			rpmhcc: clock-controller {
				compatible = "qcom,sm7250-rpmh-clk";
				#clock-cells = <1>;
			};
			rpmhpd: power-controller {
				/* lito cmd-db 有 cx/mx/lcx/lmx/gfx/mss/ebi 级别，无 mmcx/ebi 外其余与
								   sm7150 集合完全一致；缺资源时 rpmhpd 整体 -ENODEV，故借用 sm7150 */
				compatible = "qcom,sm7250-rpmhpd";
				#power-domain-cells = <1>;
				operating-points-v2 = <&rpmhpd_opp_table>;
				rpmhpd_opp_table: opp-table {
					compatible = "operating-points-v2";
					rpmhpd_opp_ret: opp1 {
						opp-level = <16>;
					};
					rpmhpd_opp_min_svs: opp2 {
						opp-level = <48>;
					};
					rpmhpd_opp_low_svs: opp3 {
						opp-level = <64>;
					};
					rpmhpd_opp_svs: opp4 {
						opp-level = <128>;
					};
					rpmhpd_opp_svs_l1: opp5 {
						opp-level = <192>;
					};
					rpmhpd_opp_nom: opp6 {
						opp-level = <0x100>;
					};
					rpmhpd_opp_nom_l1: opp7 {
						opp-level = <0x140>;
					};
					rpmhpd_opp_nom_l2: opp8 {
						opp-level = <0x150>;
					};
					rpmhpd_opp_turbo: opp9 {
						opp-level = <0x180>;
					};
					rpmhpd_opp_turbo_l1: opp10 {
						opp-level = <0x1a0>;
					};
				};
			};
			apps_bcm_voter: bcm-voter {
				compatible = "qcom,bcm-voter";
			};
		};
		config_noc: interconnect@1500000 {
			compatible = "qcom,sm7250-config-noc";
			reg = <0 0x1500000 0 0x28000>;
			#interconnect-cells = <2>;
			qcom,bcm-voters = <&apps_bcm_voter>;
			/* 迭代 30: qnoc 幽灵 BCM(SN11/12/14/15,SH8/10)已裁表, 启用 */
			status = "okay";
		};
		system_noc: interconnect@1620000 {
			compatible = "qcom,sm7250-system-noc";
			reg = <0 0x1620000 0 0x19200>;
			#interconnect-cells = <2>;
			qcom,bcm-voters = <&apps_bcm_voter>;
			/* 迭代 30: qnoc 幽灵 BCM(SN11/12/14/15,SH8/10)已裁表, 启用 */
			status = "okay";
		};
